// Array of all bitmaps for convenience. (Total bytes used to store images in PROGMEM = 1136)
const int epd_bitmap_allArray_LEN = 1;
uint8_t switched = false;

void setup() {
  Serial.begin(9600);

  // SSD1306_SWITCHCAPVCC = generate display voltage from 3.3V internally
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    while (true)
    {
      Serial.println(F("SSD1306 allocation failed"));
    }
  }

  pinMode(UP, INPUT_PULLUP);
  pinMode(DOWN, INPUT_PULLUP);

  attachInterrupt(digitalPinToInterrupt(UP), UP_SCREEN, FALLING);
  attachInterrupt(digitalPinToInterrupt(DOWN), DOWN_SCREEN, FALLING);

  // Clear the buffer
  display.clearDisplay();
  display.display();

  drawBitmap();
  drawText();

}

void loop() {
  if (switched)
  {
    drawText();

    switched = false;
  }
}

void drawText()
{

  display.fillRect(0, 10, 128, 50, BLACK);
  display.display();

  if (position == 0)
  {
    display.fillRect(6, 12, HIGHLIGHTER_LEN, HIGHLIGHTER_HEIGHT, WHITE);
    display.display();
  } else if (position == 1)
  {
    display.fillRect(6, 24, HIGHLIGHTER_LEN, HIGHLIGHTER_HEIGHT, WHITE);
    display.display();
  } else if (position == 2)
  {
    display.fillRect(6, 36, HIGHLIGHTER_LEN, HIGHLIGHTER_HEIGHT, WHITE);
    display.display();
  } else if (position == 3)
  {
    display.fillRect(6, 48, HIGHLIGHTER_LEN, HIGHLIGHTER_HEIGHT, WHITE);
    display.display();
  }

  display.setFont(&FreeSans6pt7b);
  display.setTextColor(WHITE);

  display.setCursor(6, 20);
  display.setTextColor(position == 0 ? BLACK : WHITE);
  display.print("Change Open Time");
  display.display();

  display.setCursor(6, 32);
  display.setTextColor(position == 1 ? BLACK : WHITE);
  display.print("Change Close Time");
  display.display();

  display.setCursor(6, 44);
  display.setTextColor(position == 2 ? BLACK : WHITE);
  display.print("Change Current Time");
  display.display();

  display.setCursor(6, 56);
  display.setTextColor(position == 3 ? BLACK : WHITE);
  display.print("Factory Reset");
  display.display();
}

void UP_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {
    switched = true;

    position++;

    if (position >= 4)position = 0;

    ticks = millis();
  }
}

void DOWN_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {
    switched = true;

    position--;

    if (position >= 4)position = 3;

    ticks = millis();
  }
}

void drawBitmap(void) {
  display.clearDisplay();

  display.drawBitmap(
    (display.width()  - LOGO_WIDTH ) / 2,
    (display.height() - LOGO_HEIGHT) / 2,
    epd_bitmap_settings_content_removed_resized_128_64 , LOGO_WIDTH, LOGO_HEIGHT, 1);
  display.display();
}
