void setup() {
  Serial.begin(115200);

  // SSD1306_SWITCHCAPVCC = generate display voltage from 3.3V internally
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
    while (true)
    {
      Serial.println(F("SSD1306 allocation failed"));
    }
  }

  pinMode(NEXT, INPUT_PULLUP);
  pinMode(BACK, INPUT_PULLUP);
  pinMode(UP, INPUT_PULLUP);
  pinMode(DOWN, INPUT_PULLUP);

  attachInterrupt(digitalPinToInterrupt(NEXT), NEXT_SCREEN, FALLING);
  attachInterrupt(digitalPinToInterrupt(BACK), BACK_SCREEN, FALLING);
  attachInterrupt(digitalPinToInterrupt(UP), UP_SCREEN, FALLING);
  attachInterrupt(digitalPinToInterrupt(DOWN), DOWN_SCREEN, FALLING);

  display.clearDisplay();
  display.display();

  idle_screen(0);
}

void loop() {

  if (state != previous_state)
  {
    if (state == ENTERED)
    {

    } else if (state == OUTSIDE)
    {
      idle_screen(0);
    }
    previous_state = state;
  }
}

void idle_screen(uint8_t screens)
{
  draw_bitmap(screens);
  draw_styles();
}

void draw_bitmap(uint8_t screens)
{
  if (screens == FIRST)
  {
    display.clearDisplay();
    display.display();

    display.drawBitmap(
      (display.width()  - LOGO_WIDTH ) / 2,
      (display.height() - LOGO_HEIGHT) / 2,
      epd_bitmap_firstScreenCropped_svg__1_, LOGO_WIDTH, LOGO_HEIGHT, 1);
    display.display();
  } else if (screens == SECOND)
  {
    display.clearDisplay();
    display.display();

    display.drawBitmap(
      (display.width()  - LOGO_WIDTH ) / 2,
      (display.height() - LOGO_HEIGHT) / 2,
      epd_bitmap_firstScreenCropped_svg__1_, LOGO_WIDTH, LOGO_HEIGHT, 1);
    display.display();
  } else if (screens == THIRD)
  {
    display.clearDisplay();
    display.display();

    display.drawBitmap(
      (display.width()  - LOGO_WIDTH ) / 2,
      (display.height() - LOGO_HEIGHT) / 2,
      epd_bitmap_firstScreenCropped_svg__1_, LOGO_WIDTH, LOGO_HEIGHT, 1);
    display.display();
  }
}

void draw_styles(void) {

  display.setTextColor(WHITE);

  // Step 1 of 3
  display.setFont(&FreeSans6pt7b);
  display.setCursor(45, 20);            // Start at top-left corner
  display.println(F("Step 1 of 3"));
  display.display();

  // Set Current Time
  display.setFont(&FreeSans6pt7b);
  display.setCursor(20, 35);            // Start at top-left corner
  display.println(F("Set Current Time"));
  display.display();

  // 00:00 AM
  display.setFont(&FreeSans9pt7b);
  display.setCursor(25, 50);            // Start at top-left corner
  display.println(F("00:00 AM"));
  display.display();
}

void NEXT_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {
    time_position++;

    Serial.println("NEXT");
    state = ENTERED;

    ticks = millis();
  }
}

void BACK_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {
    time_position--;

    Serial.println("BACK");
    state = OUTSIDE;

    ticks = millis();

  }
}

void UP_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {
    time_keep[screen][time_position]++;

    if (time_keep[screen][0] > 12)
    {
      time_keep[screen][0] = 0;
    }

    if (time_keep[screen][1] >= 60)
    {
      time_keep[screen][1] = 0;
    }

    if (time_keep[screen][2] >= 2)
    {
      time_keep[screen][2] = 0;
    }

    Serial.println("UP");
    Serial.println("Screen");
    Serial.println(screen);

    Serial.println("Millis");
    Serial.println(millis());

    Serial.println(time_keep[screen][time_position]);

    ticks = millis();
  }
}

void DOWN_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {

    time_keep[screen][time_position]--;

    if (time_keep[screen][0] > 12)
    {
      time_keep[screen][0] = 12;
    }

    if (time_keep[screen][1] >= 60)
    {
      time_keep[screen][1] = 59;
    }

    if (time_keep[screen][2] >= 2)
    {
      time_keep[screen][2] = 1;
    }

    Serial.println("DOWN");
    Serial.println("Screen");
    Serial.println(screen);

    Serial.println(time_keep[screen][time_position]);

    ticks = millis();
  }
}
