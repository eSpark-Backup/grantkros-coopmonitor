void NEXT_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {
    if (state == ENTERED)
      time_position++;

    if (time_position >= 3)
    {
      time_position = 0;
    }

    update_time(time_keep[screen]);

    Serial.println("NEXT");
    state = ENTERED;
    ticks = millis();
  }
}

void BACK_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {

    time_position = 0;
    Serial.println("BACK");
    state = OUTSIDE;

    ticks = millis();

  }
}

void UP_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {
    if (state == ENTERED)
    {
      time_keep[screen][time_position]++;

      if (time_keep[screen][0] > 12)
      {
        time_keep[screen][0] = 0;
      }

      if (time_keep[screen][1] >= 60)
      {
        time_keep[screen][1] = 0;
      }

      if (time_keep[screen][2] >= 2)
      {
        time_keep[screen][2] = 0;
      }

    } else if (state == OUTSIDE)
    {
      screen++;
    }

    switched = true;

    ticks = millis();
  }
}

void DOWN_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {

    if (state == ENTERED)
    {
      time_keep[screen][time_position]--;

      if (time_keep[screen][0] > 12)
      {
        time_keep[screen][0] = 12;
      }

      if (time_keep[screen][1] >= 60)
      {
        time_keep[screen][1] = 59;
      }

      if (time_keep[screen][2] >= 2)
      {
        time_keep[screen][2] = 1;
      }

    } else if (state == OUTSIDE)
    {
      screen--;

      if (screen < 0)screen = 0;
    }

    switched = true;

    ticks = millis();
  }
}

