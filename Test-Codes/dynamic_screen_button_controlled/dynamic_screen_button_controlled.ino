void setup() {
  Serial.begin(115200);

  // SSD1306_SWITCHCAPVCC = generate display voltage from 3.3V internally
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
    while (true)
    {
      Serial.println(F("SSD1306 allocation failed"));
    }
  }

  pinMode(NEXT, INPUT_PULLUP);
  pinMode(BACK, INPUT_PULLUP);
  pinMode(UP, INPUT_PULLUP);
  pinMode(DOWN, INPUT_PULLUP);

  attachInterrupt(digitalPinToInterrupt(NEXT), NEXT_SCREEN, FALLING);
  attachInterrupt(digitalPinToInterrupt(BACK), BACK_SCREEN, FALLING);
  attachInterrupt(digitalPinToInterrupt(UP), UP_SCREEN, FALLING);
  attachInterrupt(digitalPinToInterrupt(DOWN), DOWN_SCREEN, FALLING);

  display.clearDisplay();
  display.display();

  welcome_screen();

  delay(5000);

  display.clearDisplay();
  display.display();

  idle_screen(FIRST);
}

void loop() {

  if (switched == true)
  {
    if (state == ENTERED)
    {
      if ((screen < FOURTH) && (screen >= FIRST))
      {
        update_time(time_keep[screen]);
      }

      switched = false;
    }

    else if (state == OUTSIDE)
    {
      display.clearDisplay();
      display.display();

      idle_screen(screen);

      switched = false;
    }
  }

  //  if (time_position >= 3)
  //  {
  //    time_position = 0;
  //  }

  if (state != previous_state)
  {
    if (state == OUTSIDE)
    {
      display.clearDisplay();
      display.display();

      idle_screen(screen);
    }

    previous_state = state;
  }
}

void idle_screen(uint8_t screens)
{
  draw_bitmap(screens);
  draw_styles(time_keep[screens]);
}

void update_time(uint8_t* time_to_print)
{
  String hours, minutes, am_pm = "";

  display.fillRect(0, 37, 128, HIGHLIGHTER_LEN, BLACK);
  display.display();

  if (time_position == 0)
  {
    display.fillRect(25, 37, HIGHLIGHTER_LEN, 14, WHITE);
    display.display();
  } else if (time_position == 1)
  {
    display.fillRect(25 + HIGHLIGHTER_LEN + SPACING, 37, HIGHLIGHTER_LEN, 14, WHITE);
    display.display();
  } else if (time_position == 2)
  {
    display.fillRect(25 + 2 * HIGHLIGHTER_LEN + 2 * SPACING + 5, 37, HIGHLIGHTER_LEN + 5, 14, WHITE);
    display.display();
  }

  // 00:00 AM
  display.setFont(&FreeSans9pt7b);
  display.setCursor(25, 50);

  if (time_to_print[0] < 10)
  {
    hours = "0";
    hours += String(time_to_print[0]);
  } else
  {
    hours += String(time_to_print[0]);
  }

  if (time_to_print[1] < 10)
  {
    minutes = "0";
    minutes += String(time_to_print[1]);
  } else
  {
    minutes += String(time_to_print[1]);
  }

  if (time_to_print[2] == 0)
  {
    am_pm = "AM";
  } else
  {
    am_pm = "PM";
  }

  display.setTextColor(time_position == 0 ? BLACK : WHITE);
  display.print(hours);
  display.display();

  display.setTextColor(WHITE);
  display.print(":");
  display.display();

  display.setTextColor(time_position == 1 ? BLACK : WHITE);
  display.print(minutes);
  display.display();

  display.setTextColor(WHITE);
  display.print(": ");
  display.display();

  display.setTextColor(time_position == 2 ? BLACK : WHITE);
  display.println(am_pm);
  display.display();

  display.setTextColor(WHITE);

}

