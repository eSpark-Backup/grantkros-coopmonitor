// Array of all bitmaps for convenience. (Total bytes used to store images in PROGMEM = 1136)
const int epd_bitmap_allArray_LEN = 1;
uint8_t switched = false;

void setup() {
  Serial.begin(9600);

  // SSD1306_SWITCHCAPVCC = generate display voltage from 3.3V internally
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    while (true)
    {
      Serial.println(F("SSD1306 allocation failed"));
    }
  }

  pinMode(UP, INPUT_PULLUP);
  pinMode(DOWN, INPUT_PULLUP);

  attachInterrupt(digitalPinToInterrupt(UP), UP_SCREEN, FALLING);
  attachInterrupt(digitalPinToInterrupt(DOWN), DOWN_SCREEN, FALLING);

  // Clear the buffer
  display.clearDisplay();
  display.display();

  drawBitmap();
  drawText();

}

void loop() {
  if (switched)
  {
    drawText();

    switched = false;
  }
}

void drawText()
{

  display.fillRect(0, 10, 128, 45, BLACK);
  display.display();

  if ((position == 0) || (position == 4) || (position == 8))
  {
    display.fillRect(6, 12, HIGHLIGHTER_LEN, HIGHLIGHTER_HEIGHT, WHITE);
    display.display();
  } else if ((position == 1) || (position == 5) || (position == 9))
  {
    display.fillRect(6, 22, HIGHLIGHTER_LEN, HIGHLIGHTER_HEIGHT, WHITE);
    display.display();
  } else if ((position == 2) || (position == 6) || (position == 10))
  {
    display.fillRect(6, 34, HIGHLIGHTER_LEN, HIGHLIGHTER_HEIGHT, WHITE);
    display.display();
  } else if ((position == 3) || (position == 7) || (position == 11))
  {
    display.fillRect(6, 46, HIGHLIGHTER_LEN, HIGHLIGHTER_HEIGHT, WHITE);
    display.display();
  }

  display.setFont(&FreeSans5pt7b);
  display.setTextColor(WHITE);

  display.setCursor(6, 18);
  display.setTextColor(position == 0 ? BLACK : position == 4 ? BLACK : position == 8 ? BLACK : WHITE);
  display.print(menu[0 + 4 * menu_count]);
  display.display();

  display.setCursor(6, 30);
  display.setTextColor(position == 1 ? BLACK : position == 5 ? BLACK : position == 9 ? BLACK : WHITE);
  display.print(menu[1 + 4 * menu_count]);
  display.display();

  display.setCursor(6, 42);
  display.setTextColor(position == 2 ? BLACK : position == 6 ? BLACK : position == 10 ? BLACK : WHITE);
  display.print(menu[2 + 4 * menu_count]);
  display.display();

  display.setCursor(6, 54);
  display.setTextColor(position == 3 ? BLACK : position == 7 ? BLACK : position == 11 ? BLACK : WHITE);
  display.print(menu[3 + 4 * menu_count]);
  display.display();
}

void UP_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {
    switched = true;

    position++;

    if ((position >= 0 && position < 4))
    {
      menu_count = 0;
    } else if ((position >= 4 && position < 8))
    {
      menu_count = 1;
    } else if ((position >= 8 && position < 12))
    {
      menu_count = 2;
    }

    if (position >= 12)position = 11;

    ticks = millis();
  }
}

void DOWN_SCREEN()
{
  static uint32_t ticks = 0;

  if ((millis() - ticks) > DEBOUNCE)
  {
    switched = true;

    position--;

    if ((position >= 0 && position < 4))
    {
      menu_count = 0;
    } else if ((position >= 4 && position < 8))
    {
      menu_count = 1;
    } else if ((position >= 8 && position < 12))
    {
      menu_count = 2;
    }

    if (position >= 12)position = 0;

    ticks = millis();
  }
}

void drawBitmap(void) {
  display.clearDisplay();

  display.drawBitmap(
    (display.width()  - LOGO_WIDTH ) / 2,
    (display.height() - LOGO_HEIGHT) / 2,
    epd_bitmap_Settings_01 , LOGO_WIDTH, LOGO_HEIGHT, 1);
  display.display();
}
